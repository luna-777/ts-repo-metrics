# Canonical template — copy to apps/dashboard/.env.local (never commit .env.local).
#   cp apps/dashboard/.env.example apps/dashboard/.env.local
#
# Dev tiers:
# • Minimal — omit Supabase + service role: public analyze works; persistence is in-memory only in NODE_ENV=development (see lib/supabase/server.ts).
# • Coach — add OPENAI_API_KEY for /api/chat, /api/coach-says, /api/tab-insight.
# • Storage + sign-in — add all Supabase *_KEY vars + GITHUB_OAUTH_ENCRYPTION_KEY (see VERCEL_DEPLOY.md).

# --- Optional: durable storage & GitHub sign-in (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Encrypt GitHub OAuth PATs at rest (required together with Supabase flows that store tokens)
GITHUB_OAUTH_ENCRYPTION_KEY=<long-random-secret>

# --- Optional: OpenAI-powered coach ---
# OPENAI_API_KEY=

# --- Optional: higher GitHub throughput for guests (zipball/metadata) ---
# GITHUB_TOKEN=

# Public URL of this app (no trailing slash); helps OAuth redirects behind proxies (Railway/Docker).
# APP_ORIGIN=https://your-host.example

# Optional mirrors for Docker/Railway where NEXT_PUBLIC_* was empty at image build time:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-public-key>
