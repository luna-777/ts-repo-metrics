# Supabase — optional locally; required for durable storage on Vercel.
# Quick start: copy `.env.local.sample` to `.env.local` and replace mock values.
# Get from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
#
# Public URL of this app (no trailing slash). Fixes OAuth redirects behind Railway/Docker
# when the server sees 0.0.0.0:PORT instead of your real host.
# APP_ORIGIN=https://ts-repo-metrics-production.up.railway.app
#
# Optional but recommended on Docker/Railway: same values as above; read at Node runtime
# (avoids Next build inlining empty NEXT_PUBLIC_* if the image built before vars existed).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-public-key>
#
# Encrypt GitHub OAuth access tokens at rest (any string; hashed internally). Required for “Sign in with GitHub” token storage.
GITHUB_OAUTH_ENCRYPTION_KEY=<long-random-secret>
#
# Optional: higher GitHub API rate limits for guest zipball/metadata (see VERCEL_DEPLOY.md).
# GITHUB_TOKEN=
#
# Local: omit Supabase vars → `next dev` uses in-memory + sessionStorage (see lib/supabase/server.ts).
