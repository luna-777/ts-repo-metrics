# Supabase — optional locally; required for durable storage on Vercel.
# Quick start: copy `.env.local.sample` to `.env.local` and replace mock values.
# Get from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
#
# Encrypt GitHub OAuth access tokens at rest (any string; hashed internally). Required for “Sign in with GitHub” token storage.
GITHUB_OAUTH_ENCRYPTION_KEY=<long-random-secret>
#
# Optional: higher GitHub API rate limits for guest zipball/metadata (see VERCEL_DEPLOY.md).
# GITHUB_TOKEN=
#
# Local: omit Supabase vars → `next dev` uses in-memory + sessionStorage (see lib/supabase/server.ts).
